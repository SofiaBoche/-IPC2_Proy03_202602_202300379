@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold" style="color: #576d2c;">Sistema de Autorización de Facturas</h1>
    <p class="lead text-muted">Administración de RTU, Facturación Electrónica y Reportes</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #576d2c;">Carga de Datos</h4>
                    <p class="text-muted small">Sube archivos JSON o ingresa datos para actualizar el RTU o enviar facturas.</p>
                </div>
                <a asp-page="/CargarDatos" class="btn btn-custom-primary w-100 fw-bold mt-3">Ir a Cargar Datos</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #576d2c;">Consultas y Reportes</h4>
                    <p class="text-muted small">Visualiza el historial, estadísticas en gráfica y genera reportes PDF.</p>
                </div>
                <a asp-page="/Reportes" class="btn btn-custom-pdf w-100 fw-bold mt-3">Ver Reportes</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #cc6333;">Resetear Sistema</h4>
                    <p class="text-muted small">Borra todos los datos almacenados y restablece los correlativos.</p>
                </div>
                <button type="button" class="btn text-white w-100 fw-bold mt-3" style="background-color: #cc6333; border-color: #cc6333;">Resetear Todo</button>
            </div>
        </div>
    </div>
</div>