@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold" style="color: #576d2c;">Sistema de Autorización de Facturas</h1>
    <p class="lead text-muted">Administración de RTU, Facturación Electrónica y Reportes</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #576d2c;">Carga de Datos</h4>
                    <p class="text-muted small">Sube archivos JSON o ingresa datos para actualizar el RTU o enviar facturas.</p>
                </div>
                <a asp-page="/CargarDatos" class="btn btn-custom-primary w-100 fw-bold mt-3">Ir a Cargar Datos</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #576d2c;">Consultas y Reportes</h4>
                    <p class="text-muted small">Visualiza el historial, estadísticas en gráfica y genera reportes PDF.</p>
                </div>
                <a asp-page="/Reportes" class="btn btn-custom-pdf w-100 fw-bold mt-3">Ver Reportes</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center p-3">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h4 class="fw-bold" style="color: #cc6333;">Resetear Sistema</h4>
                    <p class="text-muted small">Borra todos los datos almacenados y restablece los correlativos.</p>
                </div>
                @Html.AntiForgeryToken()
                <button type="button" class="btn text-white w-100 fw-bold mt-3" style="background-color: #cc6333; border-color: #cc6333;" onclick="resetearSistema()">Resetear Todo</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function resetearSistema() {
            if (confirm("¿Estás seguro de que deseas reiniciar todos los datos del sistema?")) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    const response = await fetch('?handler=Resetear', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });
                    
                    const data = await response.json();

                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert(data.message);
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("No se pudo realizar el reseteo desde la aplicación.");
                }
            }
        }
    </script>
}